{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shikosai34-cms",
	"main": "src/index.ts",
	"compatibility_date": "2024-11-01",
	"observability": { "enabled": true },

	// 本番デプロイ後、サイトと同一ゾーンの /cms/* に割り当てる。
	// TODO(#17): 本番ホスト名を確定する。
	// "routes": [{ "pattern": "34.shikosai.net/cms/*", "zone_name": "shikosai.net" }],

	// 秘密でない識別子はここに置く。秘密鍵は `wrangler secret put GITHUB_APP_PRIVATE_KEY`。
	"vars": {
		"GITHUB_REPO": "shikosai34/shikosai34-web",
		"GITHUB_BRANCH": "main",
		"CF_ACCESS_TEAM_DOMAIN": "shikosai.cloudflareaccess.com",
		"CF_ACCESS_AUD": "7cdca2ac0c2bdc964816d2b42166c16e79b633b47077d32b928fb96cbd30d652",
		"GITHUB_APP_ID": "4801354",
		"GITHUB_APP_INSTALLATION_ID": "158405949"
	}
}
