# CMS Backend Worker のローカル用シークレット（Wrangler が `wrangler dev` で自動読み込み）。
# このファイルをコピーして `.dev.vars` を作り、値を埋める。`.dev.vars` はコミットしない。
# 本番は `wrangler secret put <NAME>` で Cloudflare 側に登録する。

# GitHub App「decap-cms-shikosai34-web」
GITHUB_APP_ID=4801354
# gh api /orgs/shikosai34/installations --jq '.installations[] | select(.app_slug=="decap-cms-shikosai34-web").id'
GITHUB_APP_INSTALLATION_ID=158405949
# .pem を base64 で1行にしたもの: base64 -w0 decap-cms-shikosai34-web.*.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=

# Cloudflare Zero Trust Access（/admin と CMS API の保護）
# https://<team>.cloudflareaccess.com/cdn-cgi/access/certs で公開鍵を取得して JWT を検証する。
# AUD は Access アプリの「Application Audience (AUD) Tag」（Access → Applications → 対象アプリ → Overview）。
CF_ACCESS_TEAM_DOMAIN=shikosai.cloudflareaccess.com
CF_ACCESS_AUD=7cdca2ac0c2bdc964816d2b42166c16e79b633b47077d32b928fb96cbd30d652
