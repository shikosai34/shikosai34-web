---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="お問い合わせ | 第34回 茨香祭" description="茨城工業高等専門学校と第34回 茨香祭のお問い合わせ先をご案内します。">
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="Contact" icon="mail" />

			<div class="space-y-8 border-t border-text/40 pt-6">
				<section aria-labelledby="school-heading">
					<h2 id="school-heading" class="border-b-2 border-text/25 pb-2 text-xl font-medium text-text">
						茨城工業高等専門学校
					</h2>
					<div class="mt-4 space-y-2 text-base leading-relaxed text-text/85">
						<p>住所：〒312-8508 茨城県ひたちなか市中根866</p>
						<p>電話：029-271-2830(学生支援・寮務係)</p>
						<p>E-mail：gakusei★ibaraki-ct.ac.jp(学生支援・寮務係)</p>
						<p>★を@に変えてください。</p>
						<p>公式サイト：https://www.ibaraki-ct.ac.jp/</p>
					</div>
				</section>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
