---
import { Image } from 'astro:assets';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import busImage from '../../assets/access/access_bus.png';
import taxiImage from '../../assets/access/access_taxi.png';
import schoolMap from '../../assets/access/school_map.svg';

const address = '〒312-8508 茨城県ひたちなか市中根866';

const mapEmbedUrl =
	'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4022.053516903501!2d140.55073074446793!3d36.39699021221313!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x60222faa16bfeb1b%3A0x8ee69992b50722b8!2z6Iyo5Z-O5bel5qWt6auY562J5bCC6ZaA5a2m5qCh!5e0!3m2!1sja!2sjp!4v1729150639038!5m2!1sja!2sjp';

const mapLinks = [
	{ label: 'Google Map', href: 'https://maps.app.goo.gl/ZqS8dawqKPTDENz19' },
	{
		label: 'Apple Map',
		href: 'https://maps.apple.com/?address=%E3%80%92312-0011,%20%E8%8C%A8%E5%9F%8E%E7%9C%8C%E3%81%B2%E3%81%9F%E3%81%A1%E3%81%AA%E3%81%8B%E5%B8%82,%20%E4%B8%AD%E6%A0%B9866&auid=7819629652125356506&ll=36.400508,140.551520&lsp=9902&q=%E8%8C%A8%E5%9F%8E%E5%B7%A5%E6%A5%AD%E9%AB%98%E7%AD%89%E5%B0%82%E9%96%80%E5%AD%A6%E6%A0%A1',
	},
];

const busLinks = [
	{ label: 'アクセス（茨城高専ホームページ）', href: 'https://www.ibaraki-ct.ac.jp/access/' },
	{
		label: '茨城交通路線バス時刻表 勝田駅（茨城高専方面）',
		href: 'http://bus.ibako.co.jp/timetable/result/?no=1052&de=2&week=1',
	},
	{
		label: '茨城交通路線バス時刻表 茨城高専前（勝田駅方面）',
		href: 'http://bus.ibako.co.jp/timetable/result/?no=436&de=1&week=1',
	},
	{
		label: '茨城交通路線バス時刻表 深谷津（勝田駅方面）',
		href: 'http://bus.ibako.co.jp/timetable/result/?no=3710&de=2&f_from_type=1&f_from_genre=&f_from=%E6%B7%B1%E8%B0%B7%E6%B4%A5',
	},
	{
		label: '茨城交通路線バス時刻表 深谷津（足崎団地方面）',
		href: 'http://bus.ibako.co.jp/timetable/result/?no=3710&de=1&f_from_type=1&f_from_genre=&f_from=%E6%B7%B1%E8%B0%B7%E6%B4%A5',
	},
	{
		label: 'ひたちなかコミュニティバス時刻表 深谷津',
		href: 'http://bus.ibako.co.jp/timetable/result/?no=20280&de=1&f_from_type=1&f_from_genre=&f_from=%E6%B7%B1%E8%B0%B7%E6%B4%A5',
	},
];

// 増便の時刻は「発車〜到着」。
const extraBuses = [
	{
		id: 'outbound',
		direction: '往路',
		count: 8,
		route: '勝田駅発 → 茨城高専前',
		times: [
			['9:35', '9:45'],
			['10:00', '10:10'],
			['10:25', '10:35'],
			['11:00', '11:10'],
			['11:30', '11:40'],
			['12:00', '12:10'],
			['12:30', '12:40'],
			['13:00', '13:10'],
		],
	},
	{
		id: 'inbound',
		direction: '復路',
		count: 4,
		route: '茨城高専前発 → 勝田駅',
		times: [
			['15:00', '15:10'],
			['15:30', '15:45'],
			['16:10', '16:20'],
			['16:50', '17:00'],
		],
	},
];
---

<Layout title="アクセス | 第34回 茨香祭">
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="Access" icon="pin" />

			<div class="space-y-10 border-t border-text/40 pt-6">
				<div>
					<div class="overflow-hidden rounded-xl border border-text/20">
						<iframe
							src={mapEmbedUrl}
							title="茨城工業高等専門学校の地図"
							style="border:0;"
							allowfullscreen
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							class="aspect-square w-full sm:aspect-video"></iframe>
					</div>
					<p class="mt-3 text-center text-sm text-text/80">{address}</p>
					<div class="mt-3 flex flex-wrap justify-center gap-2">
						{
							mapLinks.map((link) => (
								<a
									href={link.href}
									target="_blank"
									rel="noopener noreferrer"
									class="rounded-full border border-text/30 px-3 py-1 text-sm text-text transition-colors hover:border-accent hover:text-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent"
								>
									{link.label}
								</a>
							))
						}
					</div>
				</div>

				<section aria-labelledby="bus-heading">
					<h2 id="bus-heading" class="border-b-2 border-text/25 pb-2 text-xl font-medium text-text">バスでのご来校</h2>
					<p class="mt-4 text-sm leading-relaxed text-text/80">
						JR勝田駅東口を出て左側にある、茨城交通バス2番乗り場から、いずれかのバスにお乗りください。茨城高専前で下車し、北へ進むと正門となります。
					</p>
					<p class="mt-3 text-sm leading-relaxed text-text/80">
						通常の便に加えて、以下の時間が増便されています。茨城交通路線バスの臨時便を茨城高専スクールバスとして運行します。通常のバス時刻表は下記のリンクもあわせてご確認ください。
					</p>

					<Image
						src={busImage}
						alt="勝田駅バスロータリー"
						class="mx-auto mt-6 w-full max-w-xs rounded-xl"
						widths={[370, 740]}
						sizes="(min-width: 640px) 320px, 80vw"
					/>

					<h3 class="mt-8 text-base font-medium text-text">増便のバス時刻表（茨城交通路線バス 臨時便）</h3>
					<p class="mt-1 text-xs text-text/60">時刻は発車〜到着です。</p>
					<div class="mt-4 space-y-8 sm:grid sm:grid-cols-2 sm:gap-6 sm:space-y-0">
						{
							extraBuses.map((bus) => (
								<section aria-labelledby={`${bus.id}-heading`}>
									<div class="mb-3 border-b-2 border-text/25 pb-2">
										<p class="text-sm font-medium text-main">
											{bus.direction}（{bus.count}便）
										</p>
										<h4 id={`${bus.id}-heading`} class="text-base font-medium text-text">
											{bus.route}
										</h4>
									</div>
									<ul class="grid grid-cols-2 gap-2">
										{bus.times.map(([from, to]) => (
											<li class="rounded-xl border border-text/20 bg-base px-3 py-2 text-center font-medium text-text">
												{from}〜{to}
											</li>
										))}
									</ul>
								</section>
							))
						}
					</div>

					<ul class="mt-8 list-disc space-y-2 pl-5 text-sm marker:text-text/60">
						{
							busLinks.map((link) => (
								<li>
									<a
										href={link.href}
										target="_blank"
										rel="noopener noreferrer"
										class="text-text underline hover:no-underline focus:outline-2 focus:outline-offset-2 focus:outline-accent"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</section>

				<section aria-labelledby="car-heading">
					<h2 id="car-heading" class="border-b-2 border-text/25 pb-2 text-xl font-medium text-text">
						車・タクシーでのご来校
					</h2>
					<p class="mt-4 text-sm leading-relaxed text-text/80">
						一般参加者駐車場は設置しません。お車でのお越しはお控えいただき、上記の茨城交通路線バスなどの利用をご検討ください。タクシーでお越しの方は、構内は自動車進入禁止となりますので、正門の前で降車するようお願いいたします。
					</p>
					<Image
						src={taxiImage}
						alt="タクシーでのアクセス"
						class="mx-auto mt-6 w-full max-w-xs rounded-xl"
						widths={[370, 740]}
						sizes="(min-width: 640px) 320px, 80vw"
					/>
				</section>

				<section aria-labelledby="bicycle-heading">
					<h2 id="bicycle-heading" class="border-b-2 border-text/25 pb-2 text-xl font-medium text-text">
						自転車でのご来校
					</h2>
					<p class="mt-4 text-sm leading-relaxed text-text/80">
						低学年駐輪場を一般参加者の方々へ開放します。構内では、安全のため必ず自転車を降り、スタッフの指示に従って駐輪してください。
					</p>
					{/* 地図 SVG は背景が透明で黒線のみなので、白いタイルの上に載せる。 */}
					<div class="mt-6 rounded-xl border border-text/20 bg-white p-3 sm:p-4">
						<Image src={schoolMap} alt="校内地図" class="mx-auto w-full" />
					</div>
				</section>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
