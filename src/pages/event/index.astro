---
import EventCard from '../../components/event/EventCard.astro';
import SearchIcon from '../../components/icons/SearchIcon';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import {
	EVENT_GENRE_LABELS,
	EVENT_GENRES,
	EVENT_VENUES,
	EVENT_VENUE_LABELS,
	getVisibleEvents,
	groupConsecutiveEvents,
} from '../../lib/events';

const events = await getVisibleEvents();
const venueGroups = EVENT_VENUES.map((venue) => ({
	venue,
	label: EVENT_VENUE_LABELS[venue],
	events: events.filter((event) => event.data.venue === venue),
	groups: groupConsecutiveEvents(events.filter((event) => event.data.venue === venue)),
}));
const genreFilters = EVENT_GENRES.map((value) => ({ value, label: EVENT_GENRE_LABELS[value] }));
const venueFilters = EVENT_VENUES.map((value) => ({ value, label: EVENT_VENUE_LABELS[value] }));
---

<Layout title="イベント一覧 | 第34回 茨香祭">
	<SiteHeader />

	<main class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<SectionHeading title="Events" icon="mic" />
			</div>

			<p class="mb-5 text-sm leading-relaxed text-text/80">
				校内イベントの一覧です。{' '}
				<a href="/timetable" class="text-accent underline hover:no-underline">タイムテーブルはこちら</a>
			</p>

			<div id="event-list">
				<label class="event-search mb-4 flex items-center gap-2 rounded-xl border border-text/30 px-3 py-2">
					<SearchIcon className="h-4 w-4 shrink-0 text-text/70" />
					<input
						type="search"
						name="q"
						placeholder="イベント名・企画名・出演団体を完全一致で検索"
						class="w-full bg-transparent text-sm text-text placeholder:text-text/50 focus:outline-none"
						autocomplete="off"
					/>
				</label>

				<div class="flex flex-wrap gap-2" role="group" aria-label="会場で絞り込み">
					<button
						type="button"
						class="rounded-full border border-text/30 px-3 py-1 text-sm text-text transition-colors aria-pressed:border-main aria-pressed:bg-main aria-pressed:font-medium aria-pressed:text-base"
						data-venue-filter=""
						aria-pressed="true"
					>
						すべて
					</button>
					{venueFilters.map((venue) => (
						<button
							type="button"
							class="rounded-full border border-text/30 px-3 py-1 text-sm text-text transition-colors aria-pressed:border-main aria-pressed:bg-main aria-pressed:font-medium aria-pressed:text-base"
							data-venue-filter={venue.value}
							aria-pressed="false"
						>
							{venue.label}
						</button>
					))}
				</div>

				<div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="ジャンルで絞り込み">
					{genreFilters.map((genre) => (
						<button
							type="button"
							class="rounded-full border border-text/30 px-3 py-1 text-sm text-text transition-colors aria-pressed:border-main aria-pressed:bg-main aria-pressed:font-medium aria-pressed:text-base"
							data-filter={genre.value}
							aria-pressed="false"
						>
							{genre.label}
						</button>
					))}
				</div>

				<div class="mt-4 flex items-center gap-3">
					<p class="event-count text-sm text-text/70">全 {events.length} 件</p>
					<button
						type="button"
						class="event-clear text-sm text-text underline hover:no-underline"
						hidden
					>
						絞り込みを解除
					</button>
				</div>

				<p class="event-empty mt-6 text-sm text-text/70" role="status" hidden>
					該当するイベントはありません。
				</p>

				<div class="event-groups mt-5 space-y-8">
					{venueGroups.map((venueGroup) => (
						<section data-venue-group={venueGroup.venue} aria-label={venueGroup.label}>
							<h2 class="mb-4 border-b-2 border-text/25 pb-2 text-xl font-medium text-text">{venueGroup.label}</h2>
							{venueGroup.events.length === 0 ? (
								<p class="venue-empty rounded-xl border border-text/15 px-4 py-5 text-sm text-text/60">この会場のイベントはありません。</p>
							) : (
								<div class="space-y-4">
									{venueGroup.groups.map((group) => (
										<section data-event-group class="rounded-xl border border-text/20 p-4 sm:p-5">
											<h3 class="mb-4 border-b border-text/20 pb-3 text-lg font-medium text-text">{group.name}</h3>
											<ul class="event-grid grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
												{group.events.map((event) => (
													<li
														class="event-item"
														data-venue={event.data.venue}
														data-genre={event.data.genre}
														data-title={event.data.title}
														data-performer={event.data.performer}
														data-event-name={event.data.eventName}
													>
														<a href={`/event/${event.id}`} data-event-detail class="block h-full rounded-xl focus:outline-2 focus:outline-offset-2 focus:outline-base">
															<EventCard {...event.data} />
														</a>
													</li>
												))}
											</ul>
										</section>
									))}
								</div>
							)}
						</section>
					))}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script is:inline>
	document.documentElement.classList.add('js');
</script>

<style>
	/* 検索欄はスクリプト前提。JS 無効時でも企画一覧そのものは全件表示する。 */
	.event-search {
		display: none;
	}
	html.js .event-search {
		display: flex;
	}
</style>

<script>
	const scrollKey = `stage-scroll:${location.pathname}${location.search}${location.hash}`;
	const returnScrollValue = new URLSearchParams(location.search).get('returnScrollY');
	const returnScrollY = returnScrollValue === null ? Number.NaN : Number(returnScrollValue);

	if (Number.isFinite(returnScrollY)) {
		requestAnimationFrame(() => window.scrollTo(0, returnScrollY));
		const url = new URL(location.href);
		url.searchParams.delete('returnScrollY');
		history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
	}

	window.addEventListener('pagehide', () => {
		sessionStorage.setItem(scrollKey, String(window.scrollY));
	});

	window.addEventListener('pageshow', (event) => {
		const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
		if (!event.persisted && navigation?.type !== 'back_forward') return;

		const savedY = Number(sessionStorage.getItem(scrollKey));
		if (Number.isFinite(savedY)) requestAnimationFrame(() => window.scrollTo(0, savedY));
	});

	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-event-detail]')) {
		link.addEventListener('click', () => {
			const url = new URL(link.href);
			url.searchParams.set('returnTo', `${location.pathname}${location.search}${location.hash}`);
			url.searchParams.set('returnScrollY', String(Math.round(window.scrollY)));
			link.href = url.toString();
		});
	}

	const venueButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-venue-filter]'));
	const genreButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-filter]'));
	const items = Array.from(document.querySelectorAll<HTMLLIElement>('.event-item'));
	const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-event-group]'));
	const venues = Array.from(document.querySelectorAll<HTMLElement>('[data-venue-group]'));
	const input = document.querySelector<HTMLInputElement>('.event-search input');
	const empty = document.querySelector<HTMLElement>('.event-empty');
	const count = document.querySelector<HTMLElement>('.event-count');
	const clearButton = document.querySelector<HTMLButtonElement>('.event-clear');
	const total = items.length;

	if (venueButtons.length > 0) {
		let venue = '';
		let genre = '';
		let query = '';

		const normalize = (value: string) => value.normalize('NFKC').toLowerCase();

		const render = () => {
			let shown = 0;
			for (const item of items) {
				const matchVenue = venue === '' || item.dataset.venue === venue;
				const matchGenre = genre === '' || item.dataset.genre === genre;
				const matchQuery =
					query === '' ||
					normalize(item.dataset.title ?? '') === query ||
					normalize(item.dataset.performer ?? '') === query ||
					normalize(item.dataset.eventName ?? '') === query;
				const visible = matchVenue && matchGenre && matchQuery;
				item.hidden = !visible;
				if (visible) shown += 1;
			}

			for (const group of groups) {
				group.hidden = !group.querySelector('.event-item:not([hidden])');
			}

			for (const venueGroup of venues) {
				const hasItems = Boolean(venueGroup.querySelector('.event-item'));
				const hasVisibleEvents = Boolean(venueGroup.querySelector('.event-item:not([hidden])'));
				const matchesVenue = venue === '' || venueGroup.dataset.venueGroup === venue;
				venueGroup.hidden = !matchesVenue || (hasItems && !hasVisibleEvents) || (!hasItems && (genre !== '' || query !== ''));
				const emptyMessage = venueGroup.querySelector<HTMLElement>('.venue-empty');
				if (emptyMessage) emptyMessage.hidden = hasItems || genre !== '' || query !== '';
			}

			for (const button of venueButtons) {
				button.setAttribute('aria-pressed', String(button.dataset.venueFilter === venue));
			}
			for (const button of genreButtons) {
				button.setAttribute('aria-pressed', String(button.dataset.filter === genre));
			}

			const filtered = venue !== '' || genre !== '' || query !== '';
			if (count) count.textContent = filtered ? `${shown} 件` : `全 ${total} 件`;
			if (empty) empty.hidden = shown !== 0 || (total === 0 && genre === '' && query === '');
			if (clearButton) clearButton.hidden = !filtered;

			const params = new URLSearchParams();
			if (venue) params.set('venue', venue);
			if (genre) params.set('genre', genre);
			if (query && input) params.set('q', input.value);
			const qs = params.toString();
			history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
		};

		for (const button of venueButtons) {
			button.addEventListener('click', () => {
				venue = button.dataset.venueFilter === venue ? '' : (button.dataset.venueFilter ?? '');
				render();
			});
		}

		for (const button of genreButtons) {
			button.addEventListener('click', () => {
				genre = button.dataset.filter === genre ? '' : (button.dataset.filter ?? '');
				render();
			});
		}

		input?.addEventListener('input', () => {
			query = normalize(input.value.trim());
			render();
		});

		clearButton?.addEventListener('click', () => {
			venue = '';
			genre = '';
			query = '';
			if (input) input.value = '';
			render();
		});

		const params = new URLSearchParams(location.search);
		const initialVenue = params.get('venue') ?? '';
		if (venueButtons.some((button) => button.dataset.venueFilter === initialVenue)) {
			venue = initialVenue;
		}
		const initialGenre = params.get('genre') ?? '';
		if (genreButtons.some((button) => button.dataset.filter === initialGenre)) {
			genre = initialGenre;
		}
		const initialQuery = params.get('q') ?? '';
		if (initialQuery && input) {
			input.value = initialQuery;
			query = normalize(initialQuery.trim());
		}
		if (venue || genre || query || total === 0) render();
	}
</script>
