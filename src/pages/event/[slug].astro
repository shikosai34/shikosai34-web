---
import { render } from 'astro:content';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import MainVisualLightbox from '../../components/main-visual/MainVisualLightbox';
import Layout from '../../layouts/Layout.astro';
import { getCollectionOrEmpty } from '../../lib/content';
import {
	EVENT_GENRE_LABELS,
	EVENT_STATUS_LABELS,
	EVENT_VENUE_LABELS,
	formatEventDate,
	formatEventTimeRange,
} from '../../lib/events';

export async function getStaticPaths() {
	const events = await getCollectionOrEmpty('events', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);
	return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const {
	eventName,
	title,
	performer,
	startAt,
	endAt,
	genre,
	status,
	venue,
	image,
	otherImages,
	snsLinks,
	description,
	setlist,
} = event.data;
const imageGallery = [image, ...otherImages]
	.filter((src): src is string => Boolean(src))
	.map((src) => ({ src, thumb: src }));
---

<Layout title={`${title} | イベント一覧 | 第34回 茨香祭`}>
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<article class="surface-panel mt-8 rounded-2xl p-5 text-text sm:p-8">
			<a href="/event" data-return-link class="text-base text-text underline hover:no-underline">← イベント一覧へ</a>

			{
				image && (
					<div class="mt-4 overflow-hidden rounded-xl">
						<a
							href={image}
							aria-label={`${title}の画像を拡大して見る`}
							data-lightbox-group={`event-${event.id}`}
							data-lightbox-index="0"
							class="group relative block cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
						>
							<img src={image} alt={`${title}の紹介画像`} class="aspect-video w-full object-cover" />
							<span class="absolute right-3 bottom-3 rounded-full bg-black/75 px-3 py-1.5 text-xs font-bold text-white transition-opacity sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-visible:opacity-100">
								拡大して見る
							</span>
						</a>
					</div>
				)
			}

			<div class="mt-4 flex flex-wrap gap-2 text-sm">
				<span class="rounded border border-text px-2.5 py-1">{EVENT_GENRE_LABELS[genre]}</span>
				{
					status !== 'scheduled' && (
						<span class="rounded bg-main px-2.5 py-1 font-bold text-base">
							{EVENT_STATUS_LABELS[status]}
						</span>
					)
				}
			</div>

			<p class="mt-3 text-base text-text/70">{eventName}</p>
			<h1 class:list={['mt-1 text-3xl font-bold', status === 'cancelled' && 'line-through']}>{title}</h1>
			{description && <p class="mt-3 text-base leading-relaxed text-text/90">{description}</p>}

			<dl class="mt-6 grid grid-cols-[minmax(5rem,6rem)_1fr] gap-x-3 gap-y-3 border-y border-text/20 py-4 text-base">
				<dt class="font-bold text-text/80">出演団体</dt>
				<dd class="text-text">{performer}</dd>
				<dt class="font-bold text-text/80">日時</dt>
				<dd class="text-text">{formatEventDate(startAt)} {formatEventTimeRange(startAt, endAt)}</dd>
				<dt class="font-bold text-text/80">会場</dt>
				<dd class="text-text">{EVENT_VENUE_LABELS[venue]}</dd>
			</dl>

			{setlist.length > 0 && (
				<section class="mt-6" aria-labelledby="setlist-heading">
					<h2 id="setlist-heading" class="text-lg font-bold sm:text-xl">セットリスト</h2>
					<ol class="mt-2 list-inside list-decimal space-y-1 text-base leading-relaxed text-text/90">
						{setlist.map((item) => <li>{item}</li>)}
					</ol>
				</section>
			)}

			<div class="event-body mt-6 flex flex-col gap-3 text-base leading-relaxed text-text">
				<Content />
			</div>

			{otherImages.length > 0 && (
				<section class="mt-8">
					<h2 class="mb-3 text-lg font-bold sm:text-xl">その他の写真</h2>
					<ul class="grid grid-cols-2 gap-3">
						{otherImages.map((src, index) => (
							<li>
								<a
									href={src}
									aria-label={`${title}の写真 ${index + 1}を拡大して見る`}
									data-lightbox-group={`event-${event.id}`}
									data-lightbox-index={image ? index + 1 : index}
									class="group relative block cursor-zoom-in overflow-hidden rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
								>
									<img src={src} alt={`${title}の写真 ${index + 1}`} loading="lazy" class="aspect-video w-full rounded-xl object-cover transition-transform group-hover:scale-[1.02]" />
									<span class="absolute right-2 bottom-2 rounded-full bg-black/75 px-2.5 py-1 text-xs font-bold text-white">拡大</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
			{imageGallery.length > 0 && <MainVisualLightbox group={`event-${event.id}`} items={imageGallery} client:load />}

			{snsLinks.length > 0 && (
				<section class="mt-8">
					<h2 class="mb-3 text-lg font-bold sm:text-xl">SNS・公式サイト</h2>
					<ul class="grid gap-3 sm:grid-cols-2">
						{snsLinks.map((link) => (
							<li class="overflow-hidden rounded-xl border border-text/20 bg-base/70">
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${link.label}を新しいタブで開く`}
									class:list={[
										'group flex h-full min-h-16 gap-3 transition-colors hover:bg-accent/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
										link.previewImage ? 'flex-col items-stretch' : 'items-center justify-between',
									]}
								>
									{link.previewImage && <img src={link.previewImage} alt="" loading="lazy" class="aspect-[1.91/1] w-full object-cover" />}
									<span class="flex min-w-0 flex-1 items-center justify-between gap-3 px-4 py-3">
										<span class="font-bold">{link.label}</span>
										<span class="shrink-0 text-lg font-bold text-accent" aria-hidden="true">↗</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<a
				href="/timetable"
				data-history-back
				class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-xl border border-text/40 px-5 py-3 text-base font-medium text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
			>
				タイムテーブルを見る
				<span aria-hidden="true">→</span>
			</a>
		</article>
	</main>

	<SiteFooter />
</Layout>

<script>
	const referrer = document.referrer ? new URL(document.referrer) : undefined;
	const returnLink = document.querySelector<HTMLAnchorElement>('a[data-return-link]');
	const params = new URLSearchParams(location.search);
	const returnTo = params.get('returnTo');
	const returnScrollY = params.get('returnScrollY');
	const returnUrl = returnTo ? new URL(returnTo, location.origin) : undefined;

	if (
		returnLink &&
		returnUrl?.origin === location.origin &&
		(returnUrl.pathname === '/event' || returnUrl.pathname === '/timetable')
	) {
		if (returnScrollY) returnUrl.searchParams.set('returnScrollY', returnScrollY);
		returnLink.href = `${returnUrl.pathname}${returnUrl.search}${returnUrl.hash}`;
		returnLink.textContent = returnUrl.pathname === '/timetable' ? '← タイムテーブルへ戻る' : '← イベント一覧へ戻る';
	} else if (
		returnLink &&
		referrer?.origin === location.origin &&
		(referrer.pathname === '/event' || referrer.pathname === '/timetable')
	) {
		returnLink.href = `${referrer.pathname}${referrer.search}${referrer.hash}`;
		returnLink.textContent = referrer.pathname === '/timetable' ? '← タイムテーブルへ戻る' : '← イベント一覧へ戻る';
		returnLink.dataset.historyBack = '';
	}

	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-history-back]')) {
		const target = new URL(link.href);
		if (referrer?.origin !== location.origin || referrer.pathname !== target.pathname) continue;

		link.addEventListener('click', (event) => {
			event.preventDefault();
			history.back();
		});
	}
</script>

<style>
	.event-body :global(a) {
		display: inline-flex;
		align-items: center;
		border: 1px solid currentColor;
		border-radius: 0.75rem;
		padding: 0.375rem 0.75rem;
		font-weight: 700;
		text-decoration: none;
		transition: background-color 150ms ease, color 150ms ease;
	}
	.event-body :global(a:hover) { background-color: color-mix(in srgb, currentColor 10%, transparent); }
	.event-body :global(a:focus-visible) { outline: 2px solid currentColor; outline-offset: 3px; }
	.event-body :global(strong) { font-weight: 700; }
	.event-body :global(ul) { list-style: disc; padding-left: 1.25rem; }
	.event-body :global(ol) { list-style: decimal; padding-left: 1.25rem; }
</style>
