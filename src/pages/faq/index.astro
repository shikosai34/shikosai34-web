---
import { render } from 'astro:content';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import { getCollectionOrEmpty } from '../../lib/content';

const entries = (await getCollectionOrEmpty('faq')).sort(
	(a, b) => a.data.sortOrder - b.data.sortOrder || a.data.question.localeCompare(b.data.question, 'ja'),
);
const faqs = await Promise.all(
	entries.map(async (entry) => ({
		question: entry.data.question,
		Content: (await render(entry)).Content,
	})),
);
---

<Layout title="よくある質問 | 第34回 茨香祭" description="第34回 茨香祭についてのよくある質問と回答を掲載しています。">
	<SiteHeader />

	<main class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="FAQ" icon="question" subtitle="よくある質問" />

			{faqs.length === 0 ? (
				<p class="py-8 text-center text-sm text-text/70">よくある質問は準備中です。</p>
			) : (
				<div class="mt-6 space-y-3">
					{faqs.map(({ question, Content }) => (
						<details class="faq-item bracket-frame group overflow-hidden rounded-xl bg-base/45">
							<summary class="flex cursor-pointer items-center gap-3 px-4 py-4 text-left text-sm font-medium text-text transition-colors hover:bg-base/50 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-accent sm:px-5 sm:text-base">
								<span aria-hidden="true" class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/40 text-xs font-semibold text-accent">Q</span>
								<span class="min-w-0 flex-1">{question}</span>
								<span aria-hidden="true" class="faq-toggle flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-main/15 text-xl leading-none text-accent">+</span>
							</summary>
							<div class="faq-answer border-t border-text/10 px-4 py-4 pl-[3.75rem] text-sm leading-7 text-text/85 sm:px-5 sm:pl-[4.25rem]">
								<Content />
							</div>
						</details>
					))}
				</div>
			)}
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	.faq-item > summary {
		list-style: none;
	}
	.faq-item > summary::-webkit-details-marker {
		display: none;
	}
	.faq-item[open] .faq-toggle {
		transform: rotate(45deg);
	}
	.faq-answer :global(p + p) {
		margin-top: 0.75rem;
	}
	.faq-answer :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
	.faq-answer :global(ul) {
		margin-top: 0.5rem;
		list-style: disc;
		padding-left: 1.25rem;
	}
	.faq-answer :global(ol) {
		margin-top: 0.5rem;
		list-style: decimal;
		padding-left: 1.25rem;
	}
</style>
