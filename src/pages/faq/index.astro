---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';

const entries = await getCollection('faq');
const sortedEntries = entries.toSorted((a, b) =>
	a.data.category.localeCompare(b.data.category, 'ja') ||
	a.data.question.localeCompare(b.data.question, 'ja'),
);
const categories = [...new Set(sortedEntries.map((entry) => entry.data.category))];
const answers = await Promise.all(sortedEntries.map((entry) => render(entry)));
---

<Layout title="よくある質問 | 第34回 茨香祭" description="第34回 茨香祭について、よくある質問と回答をご案内します。">
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="FAQ" icon="question" subtitle="よくある質問" />

			{categories.length === 0 ? (
				<p class="py-8 text-center text-sm text-text/70">よくある質問は準備中です。</p>
			) : (
				<div class="space-y-8">
					{categories.map((category) => (
						<section aria-labelledby={`faq-${category}`}>
							<h2 id={`faq-${category}`} class="mb-3 border-b border-accent/30 pb-2 text-lg font-medium text-accent">
								{category}
							</h2>
							<div class="space-y-3">
								{sortedEntries
									.map((entry, index) => ({ entry, index }))
									.filter(({ entry }) => entry.data.category === category)
									.map(({ entry, index }) => {
										const { Content } = answers[index];
										return (
											<article class="rounded-xl border border-accent/40 bg-base/40 px-4 py-3">
												<h3 class="flex items-start gap-3 font-medium text-text">
													<span class="shrink-0 text-accent" aria-hidden="true">Q.</span>
													<span class="min-w-0 flex-1">{entry.data.question}</span>
												</h3>
												<div class="faq-answer mt-4 border-t border-white/10 pt-4 pl-7 text-sm leading-7 text-text/80">
													<Content />
													{entry.data.referenceLinks.length > 0 && (
														<div class="mt-4">
															<p class="mb-1 text-xs font-medium text-text/60">参考リンク</p>
															<ul class="space-y-1">
																{entry.data.referenceLinks.map((link) => (
																	<li>
																		<a class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent" href={link.url} target="_blank" rel="noreferrer">
																			{link.label} <span aria-hidden="true">↗</span>
																		</a>
																	</li>
																))}
															</ul>
														</div>
													)}
												</div>
											</article>
										);
									})}
							</div>
						</section>
					))}
				</div>
			)}
		</section>
	</main>

	<SiteFooter />
</Layout>

<style>
	.faq-answer :global(p + p) {
		margin-top: 0.75rem;
	}

	.faq-answer :global(ul),
	.faq-answer :global(ol) {
		margin: 0.75rem 0;
		padding-left: 1.5rem;
	}

	.faq-answer :global(ul) {
		list-style: disc;
	}

	.faq-answer :global(ol) {
		list-style: decimal;
	}

	.faq-answer :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
