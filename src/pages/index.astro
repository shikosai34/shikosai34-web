---
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import BreakingNewsHero from '../components/home/BreakingNewsHero';
import BusDepartureBoard from '../components/home/BusDepartureBoard';
import CountdownSection from '../components/home/CountdownSection';
import ThemeModel from '../components/home/ThemeModel';
import ThemeSection from '../components/home/ThemeSection';
import NewsSection from '../components/home/NewsSection';
import VideoSection from '../components/home/VideoSection';
import StageEventSection from '../components/home/StageEventSection';
import VisitorGuideSection from '../components/home/VisitorGuideSection.astro';
import logoG from '../assets/logo/yokogaki/HOL_G-trimmed.png';
import Layout from '../layouts/Layout.astro';
import { EVENT_VENUE_LABELS, getCompleteEvents } from '../lib/events';
import { formatNewsDate } from '../lib/news';
import { getVisibleNews } from '../lib/news-collection';
import { getFeaturedVideos } from '../lib/videos';
import { getPosterFullImage, getPosterImage, posterAlt as posterAltText } from '../lib/poster';

const [posterImage, posterFull] = await Promise.all([getPosterImage(), getPosterFullImage()]);

const latestNews = (await getVisibleNews()).slice(0, 3).map((entry) => ({
	href: `/news/${entry.id}`,
	title: entry.data.title,
	date: formatNewsDate(entry.data.publishedAt),
	category: entry.data.category,
	image: entry.data.image,
}));

const videos = await getFeaturedVideos();

const stageEvents = (await getCompleteEvents())
	.filter((entry) => entry.data.venue === 'main-stage')
	.map((entry) => ({
		href: `/event/${entry.id}`,
		title: entry.data.title,
		eventName: entry.data.eventName,
		performer: entry.data.performer,
		startAt: entry.data.startAt.toISOString(),
		endAt: entry.data.endAt.toISOString(),
		status: entry.data.status,
		venue: EVENT_VENUE_LABELS[entry.data.venue],
	}));
---

<Layout title="第34回 茨香祭 | 茨城工業高等専門学校 文化祭" ogImage="/og/home.jpg">
	<SiteHeader />

	<main class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
		<CountdownSection client:load logoSrc={logoG.src} />

		<BreakingNewsHero
			client:load
			posterSrc={posterImage.src}
			posterWidth={posterImage.attributes.width}
			posterHeight={posterImage.attributes.height}
			posterAlt={posterAltText}
			posterFullSrc={posterFull.src}
			posterFullWidth={Number(posterFull.attributes.width)}
			posterFullHeight={Number(posterFull.attributes.height)}
		/>

		<ThemeSection>
			<ThemeModel slot="mark" client:only="react" />
		</ThemeSection>

		<BusDepartureBoard client:load />

		<section class="surface-panel mt-6 rounded-2xl p-5 sm:p-6" aria-labelledby="festival-guide-title">
			<div class="mb-5">
				<h2 id="festival-guide-title" class="text-xl font-medium tracking-wide text-text">会場・サークル案内</h2>
				<p class="mt-1 text-xs tracking-[0.2em] text-accent/80">GUIDE</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-2">
				<a href="/circle/" class="bracket-frame group rounded-xl bg-base/45 p-5 transition-colors hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">CIRCLE</p>
					<h3 class="text-lg font-medium text-text group-hover:text-accent">サークルを探す</h3>
					<p class="mt-2 text-sm leading-7 text-text/75">出展サークルの内容や場所をチェックできます。</p>
					<p class="mt-4 text-sm text-accent underline underline-offset-4 group-hover:no-underline">サークル一覧を見る →</p>
				</a>
				<a href="/map/" class="bracket-frame group rounded-xl bg-base/45 p-5 transition-colors hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">VENUE MAP</p>
					<h3 class="text-lg font-medium text-text group-hover:text-accent">会場マップを見る</h3>
					<p class="mt-2 text-sm leading-7 text-text/75">会場内の建物やサークルの場所を地図で確認できます。</p>
					<p class="mt-4 text-sm text-accent underline underline-offset-4 group-hover:no-underline">会場マップのページへ →</p>
				</a>
			</div>
		</section>

		<VisitorGuideSection />

		<section class="surface-panel mt-6 rounded-2xl p-5 sm:p-6" aria-labelledby="staff-intro-title">
			<div class="mb-5">
				<h2 id="staff-intro-title" class="text-xl font-medium tracking-wide text-text">実行委員紹介</h2>
				<p class="mt-1 text-xs tracking-[0.2em] text-accent/80">STAFF</p>
			</div>
			<VideoSection client:visible videos={videos} />
			<div class="grid gap-4 sm:grid-cols-2">
				<a href="/greeting/" class="bracket-frame group rounded-xl bg-base/45 p-5 transition-colors hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">MESSAGES</p>
					<h3 class="text-lg font-medium text-text group-hover:text-accent">校長・実行委員長のご挨拶</h3>
					<p class="mt-2 text-sm leading-7 text-text/75">第34回茨香祭に寄せたご挨拶を紹介します。</p>
				</a>
				<a href="/staff/" class="bracket-frame group rounded-xl bg-base/45 p-5 transition-colors hover:border-accent/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">DEPARTMENTS</p>
					<h3 class="text-lg font-medium text-text group-hover:text-accent">部署紹介</h3>
					<p class="mt-2 text-sm leading-7 text-text/75">茨香祭をつくる各部署とメンバーを紹介します。</p>
				</a>
			</div>
		</section>

		{/*
		 * 広い画面では Stage Events と News を横に並べる。
		 * どちらも縦に短いパネルなので、1 列に積むと PC では間延びする。
		 */}
		<div class="lg:grid lg:grid-cols-2 lg:gap-6">
			<StageEventSection client:load events={stageEvents} />
			<NewsSection items={latestNews} />
		</div>
	</main>

	<SiteFooter />
</Layout>
