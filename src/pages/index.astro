---
import { getImage } from 'astro:assets';
import posterAsset from '../assets/poster/sokuhou/01-poster.png';
import logoG from '../assets/logo/yokogaki/HOL_G-trimmed.png';
import Header from '../components/layout/Header';
import SiteFooter from '../components/layout/SiteFooter.astro';
import EdgeKasumi from '../components/layout/EdgeKasumi';
import BreakingNewsHero from '../components/home/BreakingNewsHero';
import ThemeModel from '../components/home/ThemeModel';
import ThemeSection from '../components/home/ThemeSection';
import NewsSection from '../components/home/NewsSection';
import StageEventSection from '../components/home/StageEventSection';
import Layout from '../layouts/Layout.astro';
import { getVisibleEvents } from '../lib/events';
import { formatNewsDate } from '../lib/news';
import { getVisibleNews } from '../lib/news-collection';

const posterImage = await getImage({
	src: posterAsset,
	width: 800,
	format: 'webp',
});

// 裏面用。円で切り抜く表面では四隅が欠けるため、
// タイルを裏返した面には文字が読める大きさのものを渡す。
const posterFull = await getImage({
	src: posterAsset,
	width: 1600,
	format: 'webp',
});

const posterAltText =
	'茨香祭2026 ポスター。第34回茨香祭 テーマ「守破離」。一般公開は10月24日（土）9:00〜17:00、25日（日）は学内限定。茨城工業高等専門学校。';

const latestNews = (await getVisibleNews()).slice(0, 3).map((entry) => ({
	href: `/news/${entry.id}`,
	title: entry.data.title,
	date: formatNewsDate(entry.data.publishedAt),
	category: entry.data.category,
	image: entry.data.image,
}));

const stageEvents = (await getVisibleEvents()).map((entry) => ({
	href: `/event/${entry.id}`,
	title: entry.data.title,
	performer: entry.data.performer,
	startAt: entry.data.startAt.toISOString(),
	endAt: entry.data.endAt.toISOString(),
	status: entry.data.status,
}));
---

<Layout title="茨香祭速報 | 第34回 茨香祭">
	{/* 画面の左右端に固定する霞。スクロールしても残る。 */}
	<EdgeKasumi />

	<Header client:load logoSrc={logoG.src} />

	<main class="mx-auto w-full max-w-2xl pb-16">
		<BreakingNewsHero
			client:load
			posterSrc={posterImage.src}
			posterWidth={posterImage.attributes.width}
			posterHeight={posterImage.attributes.height}
			posterAlt={posterAltText}
			posterFullSrc={posterFull.src}
			posterFullWidth={Number(posterFull.attributes.width)}
			posterFullHeight={Number(posterFull.attributes.height)}
		/>

		<ThemeSection>
			<ThemeModel slot="mark" client:only="react" />
		</ThemeSection>
		<StageEventSection client:load events={stageEvents} />
		<NewsSection items={latestNews} />
	</main>

	<SiteFooter />
</Layout>
