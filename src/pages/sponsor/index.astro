---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import { getSponsorSizeClass, getVisibleSponsors } from '../../lib/sponsors';

const sponsors = await getVisibleSponsors();
const maxAmount = Math.max(0, ...sponsors.map(({ data }) => data.amount));
---

<Layout title="協賛 | 第34回 茨香祭">
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="Sponsor" icon="handshake" />

			{
				sponsors.length === 0 ? (
					<p class="py-8 text-center text-sm text-text/70">協賛企業情報は準備中です。</p>
				) : (
					<>
						<p class="mb-6 text-sm leading-relaxed text-text/80">
							第34回茨香祭を開催するにあたり、非常に多くの方々にご協賛をいただきました。
							ここに深くお礼申し上げます。（敬称略・五十音順）
						</p>

						<ul class="flex flex-wrap items-baseline gap-x-6 gap-y-3">
							{sponsors.map(({ data }) => (
								<li class={`text-text ${getSponsorSizeClass(data.amount, maxAmount)}`}>
									{data.url ? (
										<a
											href={data.url}
											target="_blank"
											rel="noopener noreferrer"
											class="underline hover:no-underline"
										>
											{data.name}
										</a>
									) : (
										<span>{data.name}</span>
									)}
								</li>
							))}
						</ul>
					</>
				)
			}
		</section>
	</main>

	<SiteFooter />
</Layout>
