---
import { getCollection } from 'astro:content';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';

const cmsDepartments = await getCollection('staff');
const demoDepartments = [
	{
		id: 'local-demo-planning',
		data: {
			sortOrder: 1,
			department: '企画部（ローカルデモ）',
			members: [
				{ role: '部長', name: 'デモ 太郎', kana: 'でも たろう' },
				{ role: '副部長', name: 'サンプル 花子', kana: 'さんぷる はなこ' },
				{ role: '部長', name: 'テスト 次郎', kana: 'てすと じろう' },
			],
			description: '役職ごとの表示確認用サンプルです。同じ「部長」のメンバーをまとめて表示しています。',
			image: undefined,
		},
	},
	{
		id: 'local-demo-publicity',
		data: {
			sortOrder: 2,
			department: '広報部（ローカルデモ）',
			members: [{ role: '担当', name: '見本 三花', kana: 'みほん みか' }],
			description: 'CMSに写真を登録していない場合の表示例です。',
			image: undefined,
		},
	},
];
const departmentEntries = import.meta.env.DEV && cmsDepartments.length === 0 ? demoDepartments : cmsDepartments;

const departments = departmentEntries
	.sort((a, b) => a.data.sortOrder - b.data.sortOrder || a.data.department.localeCompare(b.data.department, 'ja'))
	.map((department) => {
		const membersByRole = new Map<string, typeof department.data.members>();
		for (const member of department.data.members) {
			const members = membersByRole.get(member.role) ?? [];
			members.push(member);
			membersByRole.set(member.role, members);
		}
		return { ...department, membersByRole: [...membersByRole] };
	});
---

<Layout title="実行委員紹介 | 第34回 茨香祭" description="第34回茨香祭をつくる実行委員会のスタッフを紹介します。">
	<SiteHeader />

	<main class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="Staff" icon="badge" subtitle="実行委員紹介" />

			<div class="mt-6 grid gap-4 lg:grid-cols-2">
				<article class="bracket-frame rounded-xl bg-base/45 p-5 sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">MESSAGE 01</p>
					<h2 class="mb-4 text-lg font-medium text-text">校長挨拶</h2>
					<p class="whitespace-pre-line text-sm leading-8 text-text/85">いよいよ第34回茨香祭が開催されます。茨香祭は2年に1回開催される茨城高専の文化祭であり、1回に2年分のエネルギーが注入される分、気合の入ったイベントになることでしょう。多くのイベントや出店もあり、にぎやかなお祭りになりそうです。さて、今回のテーマは「守破離」です。その意味は茨香祭公式ウェブページなどで解説されているのでここでは割愛しますが、かっこいい言葉なので守破離が大好きなおじさんは数多く、もともとの分野である茶の湯や武道のみならず、調べてみると医療、企業経営、ものづくり、人材育成、高等教育、サービス産業など、あらゆる分野で「守破離」が使われています。今年は茨香祭がそのリストに加わったわけですが、これまでの茨香祭の伝統を受け継ぐ「守」に加えて、学生諸君がどのような「破離」を見せてくれるのか、大いに期待しています。最後に、学生を見守っていただく先生方、茨香祭にご協力いただいた後援会と同窓会の皆様、地域の皆様に改めてお礼を申し上げます。</p>
				</article>

				<article class="bracket-frame rounded-xl bg-base/45 p-5 sm:p-6">
					<p class="mb-3 text-xs tracking-[0.2em] text-accent">MESSAGE 02</p>
					<h2 class="mb-4 text-lg font-medium text-text">実行委員長挨拶</h2>
					<div class="space-y-4 text-sm leading-8 text-text/85">
						<p>2年に一度開催される茨香祭は、学生一人ひとりの「やってみたい」が形になる、茨城高専ならではの舞台です。</p>
						<p>今回のテーマは「守破離」。これまで先輩方が築いてきた伝統を大切にしながらも、その枠にとらわれず、新しい茨香祭を創り上げることに挑戦してきました。企画の充実はもちろん、デジタル技術の活用や他高専との交流など、高専生ならではの発想を随所に取り入れています。</p>
						<p>準備を進める中では、数多くの困難もありました。しかし、実行委員をはじめとする学生の皆さん、先生方、そして地域・関係者の皆様のご協力によって、今日を迎えることができました。この場を借りて、心より感謝申し上げます。</p>
						<p>この2日間が、皆様にとって新たな発見や出会いにあふれ、記憶に残る時間となれば幸いです。</p>
						<p>どうぞ、第34回茨香祭を最後までお楽しみください。</p>
					</div>
					<p class="mt-5 text-right text-sm leading-7 text-text">第34回茨香祭実行委員長<br /><span class="text-accent">國井 真帆</span></p>
				</article>
			</div>
		</section>

		<section class="surface-panel mt-6 rounded-2xl p-4 pt-6 pb-6 sm:p-6" aria-label="部署紹介">
			<div class="mb-6">
				<SectionHeading title="Departments" icon="badge" subtitle="部署紹介" />
			</div>
			{departments.length === 0 ? (
				<p class="py-8 text-center text-sm text-text/70">部署紹介は準備中です。</p>
			) : (
				<div class="grid gap-5 md:grid-cols-2">
					{departments.map(({ data, membersByRole }) => (
						<article class="bracket-frame overflow-hidden rounded-xl bg-base/45">
							{data.image ? (
								<img src={data.image} alt={`${data.department}の写真`} loading="lazy" class="aspect-[16/9] w-full object-cover" />
							) : (
								<div aria-hidden="true" class="halftone flex aspect-[16/9] items-center justify-center bg-base/50">
									<span class="text-5xl font-medium tracking-widest text-accent/80">茨香祭</span>
								</div>
							)}
							<div class="p-5 sm:p-6">
								<h3 class="mb-3 text-lg font-medium text-text">{data.department}</h3>
								<p class="whitespace-pre-line text-sm leading-7 text-text/80">{data.description}</p>
								{data.members.length > 0 && (
									<div class="mt-5 border-t border-text/15 pt-4">
										<h4 class="mb-3 text-xs tracking-widest text-accent">MEMBERS</h4>
										<div class="space-y-4">
											{membersByRole.map(([role, members]) => (
												<div>
													<h5 class="mb-2 text-sm font-medium text-main">{role}</h5>
													<ul class="flex flex-wrap gap-2">
														{members.map((member) => (
															<li class="rounded-md border border-text/15 bg-base/60 px-3 py-2 text-sm text-text">
																<span>{member.name}</span>
																<span class="ml-1 text-xs text-text/55">（{member.kana}）</span>
															</li>
														))}
													</ul>
												</div>
											))}
										</div>
									</div>
								)}
							</div>
						</article>
					))}
				</div>
			)}
		</section>
	</main>

	<SiteFooter />
</Layout>
