---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import NewsListItem from '../../components/news/NewsListItem';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import { formatNewsDate } from '../../lib/news';
import { getVisibleNews } from '../../lib/news-collection';

const items = (await getVisibleNews()).map((entry) => ({
	href: `/news/${entry.id}`,
	title: entry.data.title,
	date: formatNewsDate(entry.data.publishedAt),
	category: entry.data.category,
	image: entry.data.image,
}));
---

<Layout title="お知らせ | 第34回 茨香祭">
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title="News" icon="newspaper" />

			<div class="border-t border-text/40 pt-2">
				{
					items.length === 0 ? (
						<p class="py-6 text-center text-sm text-text/70">現在お知らせはありません。</p>
					) : (
						<ul class="divide-y divide-text/10">
							{items.map((item) => (
								<NewsListItem {...item} />
							))}
						</ul>
					)
				}
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
