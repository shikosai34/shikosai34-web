---
import { getCollection, render } from 'astro:content';
import logoG from '../../assets/logo/yokogaki/HOL_G-trimmed.png';
import logoW from '../../assets/logo/yokogaki/HOL_W-trimmed.png';
import kosenLogo from '../../assets/logo/kosen/footer.svg';
import CalendarIcon from '../../components/icons/CalendarIcon';
import Footer from '../../components/layout/Footer';
import Header from '../../components/layout/Header';
import Layout from '../../layouts/Layout.astro';
import { NEWS_CATEGORY_LABELS, formatNewsDate } from '../../lib/news';

export async function getStaticPaths() {
	const entries = await getCollection('news', ({ data }) =>
		import.meta.env.PROD ? !data.draft : true,
	);

	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, publishedAt, updatedAt, category, image, description } = entry.data;
---

<Layout title={`${title} | 第34回 茨香祭 お知らせ`}>
	<Header client:load logoSrc={logoW.src} />

	<main class="mx-auto w-full max-w-2xl px-4 pb-16">
		<article class="mt-8 rounded-2xl bg-base p-5 pt-6 pb-8">
			<div class="flex flex-wrap items-center gap-2 text-xs text-text/80">
				<span class="inline-flex items-center gap-1">
					<CalendarIcon className="h-3.5 w-3.5" />
					{formatNewsDate(publishedAt)}
				</span>
				<span class="rounded bg-text/10 px-1.5 py-0.5">{NEWS_CATEGORY_LABELS[category]}</span>
				{updatedAt && <span class="text-text/60">更新: {formatNewsDate(updatedAt)}</span>}
			</div>

			<h1 class="mt-3 text-2xl font-bold leading-snug text-text">{title}</h1>
			{description && <p class="mt-2 text-sm text-text/80">{description}</p>}

			{
				image && (
					<img src={image} alt="" loading="lazy" class="mt-5 w-full rounded-xl object-cover" />
				)
			}

			<div class="news-body mt-6 flex flex-col gap-4 leading-relaxed text-text/90">
				<Content />
			</div>

			<div class="mt-8 border-t border-text/20 pt-4">
				<a href="/news" class="text-sm text-accent hover:underline">← お知らせ一覧へ</a>
			</div>
		</article>
	</main>

	<Footer logoSrc={logoG.src} kosenLogoSrc={kosenLogo.src} />
</Layout>

<style>
	.news-body :global(a) {
		color: var(--color-accent);
		text-decoration: underline;
	}
	.news-body :global(strong) {
		font-weight: 700;
	}
	.news-body :global(ul) {
		list-style: disc;
		padding-left: 1.25rem;
	}
	.news-body :global(ol) {
		list-style: decimal;
		padding-left: 1.25rem;
	}
</style>
