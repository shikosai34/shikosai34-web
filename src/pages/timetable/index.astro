---
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';
import {
	EVENT_GENRE_LABELS,
	EVENT_STATUS_LABELS,
	EVENT_VENUE_LABELS,
	FESTIVAL_DAYS,
	formatEventTime,
	getEventDayKey,
	getVisibleEvents,
	groupConsecutiveEvents,
} from '../../lib/events';

const events = await getVisibleEvents();
---

<Layout title="タイムテーブル | 第34回 茨香祭">
	<SiteHeader />

	<main class="mx-auto w-full max-w-5xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<div class="flex flex-wrap items-baseline justify-between gap-3">
				<SectionHeading title="Timetable" icon="clock" />
				<a href="/event" class="text-sm text-text underline hover:no-underline">企画一覧で見る</a>
			</div>

			<div>
				<p class="text-sm leading-relaxed text-text/80">
					各会場の予定を開始時刻順に掲載しています。同じイベント名の連続する企画をまとめ、当日の変更も表示します。
				</p>
				<nav class="mt-4 flex flex-wrap gap-2" aria-label="開催日">
					{FESTIVAL_DAYS.map((day) => (
						<a
							href={`#${day.id}`}
							class="rounded-full border border-text/30 px-3 py-1 text-sm text-text transition-colors hover:border-accent hover:text-accent focus:outline-2 focus:outline-offset-2 focus:outline-accent"
						>
							<span class="font-medium">{day.shortLabel}</span>
							<span class="ml-1 text-xs text-text/60">{day.label}</span>
						</a>
					))}
				</nav>
			</div>

			{/* 開催日は 2 日だけなので、広い画面では日ごとの列を横に並べる。 */}
			<div class="mt-8 space-y-12 lg:grid lg:grid-cols-2 lg:gap-8 lg:space-y-0">
				{
					FESTIVAL_DAYS.map((day) => {
						const dayEvents = events.filter((event) => getEventDayKey(event.data.startAt) === day.date);
						const eventGroups = groupConsecutiveEvents(dayEvents);
						return (
							<section id={day.id} class="scroll-mt-24" aria-labelledby={`${day.id}-heading`}>
								<div class="mb-5 flex items-end justify-between gap-4 border-b-2 border-text/25 pb-2">
									<div>
										<p class="text-sm font-medium text-main">{day.shortLabel}</p>
										<h2 id={`${day.id}-heading`} class="text-xl font-medium text-text">{day.label}</h2>
									</div>
								</div>

								{dayEvents.length === 0 ? (
									<div class="rounded-xl border border-text/20 px-5 py-8 text-center text-sm text-text/70">
										この日の予定は準備中です。
									</div>
								) : (
									<ol class="space-y-4">
										{eventGroups.map((group) => (
											<li class="overflow-hidden rounded-xl border border-text/20 bg-text/[0.03]">
												<h3 class="border-b border-text/20 px-4 py-3 text-base font-medium text-accent sm:px-5">{group.name}</h3>
												<ol class="divide-y divide-text/15 px-3 sm:px-5">
													{group.events.map((event) => (
														<li class="grid grid-cols-[4.5rem_1fr] gap-3 py-4 sm:grid-cols-[6rem_1fr] lg:grid-cols-[4.5rem_1fr]">
															<div class="pt-1 text-right">
																<time datetime={event.data.startAt.toISOString()} class="block font-medium text-text">
																	{formatEventTime(event.data.startAt)}
																</time>
																<span class="text-xs text-text/60">〜{formatEventTime(event.data.endAt)}</span>
															</div>
															<a
																href={`/event/${event.id}`}
																data-event-detail
																class="flex min-w-0 overflow-hidden rounded-lg border border-text/20 bg-base text-text transition-transform hover:-translate-y-0.5 focus:outline-2 focus:outline-offset-2 focus:outline-accent"
															>
															<div class="kikko w-24 shrink-0 bg-text/5">
																	{event.data.image ? (
																		<img src={event.data.image} alt="" loading="lazy" class="h-full w-full object-cover" />
																	) : (
																		<div class="flex h-full min-h-24 items-center justify-center px-2 text-center text-xs text-text/60" aria-hidden="true">
																			画像準備中
																		</div>
																		)}
																</div>
																<div class="min-w-0 flex-1 p-3 sm:p-4">
																	<div class="flex flex-wrap gap-2 text-xs">
																		<span class="rounded border border-text/60 px-2 py-0.5">{EVENT_GENRE_LABELS[event.data.genre]}</span>
																		<span class="rounded border border-text/40 px-2 py-0.5">{EVENT_VENUE_LABELS[event.data.venue]}</span>
																		{event.data.status !== 'scheduled' && (
																			<span class="rounded bg-main px-2 py-0.5 font-medium text-base">{EVENT_STATUS_LABELS[event.data.status]}</span>
																		)}
																	</div>
																	<h4 class:list={['mt-2 font-medium', event.data.status === 'cancelled' && 'line-through']}>{event.data.title}</h4>
																	<p class="mt-1 text-sm text-text/70">{event.data.performer}</p>
																</div>
															</a>
														</li>
													))}
												</ol>
											</li>
										))}
									</ol>
								)}
							</section>
						);
					})
				}
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	const scrollKey = `stage-scroll:${location.pathname}${location.search}${location.hash}`;
	const returnScrollValue = new URLSearchParams(location.search).get('returnScrollY');
	const returnScrollY = returnScrollValue === null ? Number.NaN : Number(returnScrollValue);

	if (Number.isFinite(returnScrollY)) {
		requestAnimationFrame(() => window.scrollTo(0, returnScrollY));
		const url = new URL(location.href);
		url.searchParams.delete('returnScrollY');
		history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
	}

	window.addEventListener('pagehide', () => {
		sessionStorage.setItem(scrollKey, String(window.scrollY));
	});

	window.addEventListener('pageshow', (event) => {
		const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
		if (!event.persisted && navigation?.type !== 'back_forward') return;

		const savedY = Number(sessionStorage.getItem(scrollKey));
		if (Number.isFinite(savedY)) requestAnimationFrame(() => window.scrollTo(0, savedY));
	});

	for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-event-detail]')) {
		link.addEventListener('click', () => {
			const url = new URL(link.href);
			url.searchParams.set('returnTo', `${location.pathname}${location.search}${location.hash}`);
			url.searchParams.set('returnScrollY', String(Math.round(window.scrollY)));
			link.href = url.toString();
		});
	}
</script>
