---
import SectionHeading from '../../components/ui/SectionHeading';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import {
	EVENT_VENUE_LABELS,
	FESTIVAL_DAYS,
	formatEventTime,
	getCommitteeEvents,
	getEventDayKey,
	groupConsecutiveEvents,
} from '../../lib/events';

// Production access is restricted by the existing Cloudflare Access application covering /admin*.
const events = await getCommitteeEvents();
const dayGroups = FESTIVAL_DAYS.map((day) => ({
	...day,
	groups: groupConsecutiveEvents(events.filter((event) => getEventDayKey(event.data.startAt) === day.date)),
})).filter((day) => day.groups.length > 0);
---

<Layout title="実行委員限定のイベント | 第34回 茨香祭" noIndex>
	<SiteHeader />

	<main class="mx-auto w-full max-w-4xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<div class="flex flex-wrap items-center justify-between gap-3">
				<SectionHeading title="Committee Events" icon="clock" />
				<span class="rounded-full border border-main/60 bg-main/10 px-3 py-1 text-xs font-medium text-main">実行委員限定</span>
			</div>
			<p class="mt-3 text-sm leading-relaxed text-text/80">
				前夜祭・中夜祭・後夜祭の予定です。このページは実行委員向けで、Cloudflare Accessの認証が必要です。
			</p>
			<a href="/timetable" class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm text-accent underline underline-offset-4 hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
				一般公開のタイムテーブルへ <span aria-hidden="true">→</span>
			</a>

			<nav class="mt-6 flex flex-wrap gap-2 border-t border-text/20 pt-5" aria-label="限定イベントの日程へ移動">
				{dayGroups.map((day) => (
					<a href={`#${day.id}`} class="rounded-full border border-text/30 px-3 py-2 text-sm text-text transition-colors hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
						<span class="font-medium">{day.label}</span>
					</a>
				))}
			</nav>

			<div class="mt-8 space-y-8">
				{dayGroups.map((day) => (
					<section id={day.id} aria-labelledby={`${day.id}-heading`} class="scroll-mt-24">
						<div class="mb-4 border-b-2 border-text/25 pb-2">
							<h2 id={`${day.id}-heading`} class="text-xl font-medium text-text">{day.label}</h2>
						</div>
						<div class="space-y-4">
							{day.groups.map((group) => (
								<section class="overflow-hidden rounded-xl border border-main/35 bg-main/5" aria-label={`${group.name}の予定`}>
									<h3 class="border-b border-main/20 bg-main/10 px-4 py-3 text-lg font-medium text-text">{group.name}</h3>
									<ol class="divide-y divide-text/15 px-4">
										{group.events.map((event) => (
											<li class="grid grid-cols-[5.5rem_1fr] gap-3 py-4 sm:grid-cols-[7rem_1fr]">
												<time datetime={event.data.startAt.toISOString()} class="pt-0.5 text-right font-medium text-text">{formatEventTime(event.data.startAt)}<span class="block text-xs font-normal text-text/60">〜{formatEventTime(event.data.endAt)}</span></time>
												<div>
													<h4 class="font-medium text-text">{event.data.title}</h4>
													<p class="mt-1 text-sm text-text/70">{EVENT_VENUE_LABELS[event.data.venue]}</p>
												</div>
											</li>
										))}
									</ol>
								</section>
							))}
						</div>
					</section>
				))}
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>
