---
import logoG from '../../assets/logo/yokogaki/HOL_G-trimmed.png';
import logoW from '../../assets/logo/yokogaki/HOL_W-trimmed.png';
import kosenLogo from '../../assets/logo/kosen/footer.svg';
import Footer from '../../components/layout/Footer';
import Header from '../../components/layout/Header';
import ThemeSection from '../../components/home/ThemeSection';
import Layout from '../../layouts/Layout.astro';
---

<Layout title="テーマ | 第34回 茨香祭">
	<Header client:load logoSrc={logoW.src} />

	<main class="mx-auto w-full max-w-2xl pb-16">
		<ThemeSection />
	</main>

	<Footer logoSrc={logoG.src} kosenLogoSrc={kosenLogo.src} />
</Layout>
