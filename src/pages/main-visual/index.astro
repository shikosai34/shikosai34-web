---
import { getImage } from 'astro:assets';
import logoG from '../../assets/logo/yokogaki/HOL_G-trimmed.png';
import logoW from '../../assets/logo/yokogaki/HOL_W-trimmed.png';
import kosenLogo from '../../assets/logo/kosen/footer.svg';
import mv01 from '../../assets/main-visual/01.png';
import mv02 from '../../assets/main-visual/02.png';
import mv03 from '../../assets/main-visual/03.png';
import mv04 from '../../assets/main-visual/04.png';
import mv05 from '../../assets/main-visual/05.png';
import mv06 from '../../assets/main-visual/06.png';
import Footer from '../../components/layout/Footer';
import Header from '../../components/layout/Header';
import MainVisualLightbox from '../../components/main-visual/MainVisualLightbox';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';

// ビジュアル。03 は優秀賞のため先頭（PC では左上）に置く。
const visualSources = [mv03, mv01, mv02, mv04];
// オリジナルキャラクターは別の括りとして扱う。
const characterSources = [mv05, mv06];

// 原寸は最大 4961×7016 と重いので、格子用とライトボックス用の 2 段階に縮小して
// webp へ変換する（トップページのポスターと同じ `getImage` の使い方）。
async function toItems(sources: ImageMetadata[]) {
	return Promise.all(
		sources.map(async (src) => {
			const [thumb, full] = await Promise.all([
				getImage({ src, width: 600, format: 'webp' }),
				getImage({ src, width: 1600, format: 'webp' }),
			]);
			return {
				thumb: thumb.src,
				src: full.src,
				width: Number(full.attributes.width ?? full.options.width ?? 1600),
				height: Number(full.attributes.height ?? full.options.height ?? 1600),
			};
		}),
	);
}

const visualItems = await toItems(visualSources);
const characterItems = await toItems(characterSources);

// ライトボックスの送りはセクション内で完結させるため、グループごとに渡す。
const groups = [
	{ key: 'visual', items: visualItems },
	{ key: 'character', items: characterItems },
];
---

<Layout title="ビジュアル | 第34回 茨香祭">
	<Header client:load logoSrc={logoW.src} />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16">
		<section class="mt-8">
			<SectionHeading title="Visual" tone="dark" />

			<p class="text-sm leading-relaxed text-base">
				第34回 茨香祭のビジュアルとして応募いただいた作品を掲載しています。
				画像を選ぶと拡大して表示されます。
			</p>

			{/*
			 * 作品ごとに縦横比が異なるため、正方形に収めず元の比率のまま並べる。
			 * multi-column だと縦方向に流れて読み順が崩れるので、grid で左上から並べ、
			 * 高さは各画像の aspect-ratio に任せる（行ごとに上端が揃う）。
			 */}
			<ul class="mt-6 grid grid-cols-2 items-start gap-3 lg:grid-cols-3">
				{
					visualItems.map((item, index) => (
						<li>
							<a
								href={item.src}
								data-lightbox-group="visual"
								data-lightbox-index={index}
								class="block overflow-hidden rounded-xl transition-transform hover:-translate-y-0.5"
							>
								<img
									src={item.thumb}
									alt=""
									width={item.width}
									height={item.height}
									loading="lazy"
									decoding="async"
									class="w-full rounded-xl"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<section class="mt-12">
			<SectionHeading title="Original Character" tone="dark" />

			<p class="text-sm leading-relaxed text-base">
				茨香祭のオリジナルキャラクターです。
			</p>

			<ul class="mt-6 grid grid-cols-2 items-start gap-3">
				{
					characterItems.map((item, index) => (
						<li>
							<a
								href={item.src}
								data-lightbox-group="character"
								data-lightbox-index={index}
								class="block overflow-hidden rounded-xl transition-transform hover:-translate-y-0.5"
							>
								<img
									src={item.thumb}
									alt=""
									width={item.width}
									height={item.height}
									loading="lazy"
									decoding="async"
									class="w-full rounded-xl"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	{groups.map((group) => <MainVisualLightbox group={group.key} items={group.items} client:load />)}

	<Footer logoSrc={logoG.src} kosenLogoSrc={kosenLogo.src} />
</Layout>
