---
import { getImage } from 'astro:assets';
import logoG from '../../assets/logo/yokogaki/HOL_G-trimmed.png';
import logoW from '../../assets/logo/yokogaki/HOL_W-trimmed.png';
import kosenLogo from '../../assets/logo/kosen/footer.svg';
import mv01 from '../../assets/main-visual/01.png';
import mv02 from '../../assets/main-visual/02.png';
import mv03 from '../../assets/main-visual/03.png';
import mv04 from '../../assets/main-visual/04.png';
import mv05 from '../../assets/main-visual/05.png';
import mv06 from '../../assets/main-visual/06.png';
import Footer from '../../components/layout/Footer';
import Header from '../../components/layout/Header';
import MainVisualLightbox from '../../components/main-visual/MainVisualLightbox';
import SectionHeading from '../../components/ui/SectionHeading';
import Layout from '../../layouts/Layout.astro';

// 掲載順は手動。応募順などの並び順キーが決まったら差し替える。
const sources = [mv01, mv02, mv03, mv04, mv05, mv06];

// 原寸は最大 4961×7016 と重いので、格子用とライトボックス用の 2 段階に縮小して
// webp へ変換する（トップページのポスターと同じ `getImage` の使い方）。
const items = await Promise.all(
	sources.map(async (src) => {
		const [thumb, full] = await Promise.all([
			getImage({ src, width: 600, format: 'webp' }),
			getImage({ src, width: 1600, format: 'webp' }),
		]);
		return {
			thumb: thumb.src,
			src: full.src,
			width: Number(full.attributes.width ?? full.options.width ?? 1600),
			height: Number(full.attributes.height ?? full.options.height ?? 1600),
		};
	}),
);
---

<Layout title="メインビジュアル | 第34回 茨香祭">
	<Header client:load logoSrc={logoW.src} />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16">
		<section class="mt-8">
			<SectionHeading title="Main Visual" tone="dark" />

			<p class="text-sm leading-relaxed text-base">
				第34回 茨香祭のメインビジュアルとして応募いただいた作品を掲載しています。
				画像を選ぶと拡大して表示されます。
			</p>

			<ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
				{
					items.map((item, index) => (
						<li>
							<a
								href={item.src}
								data-main-visual-index={index}
								class="block overflow-hidden rounded-xl border border-base bg-base transition-transform hover:-translate-y-0.5"
							>
								<img
									src={item.thumb}
									alt=""
									loading="lazy"
									decoding="async"
									class="aspect-square w-full bg-text/5 object-contain"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>

	<MainVisualLightbox items={items} client:load />

	<Footer logoSrc={logoG.src} kosenLogoSrc={kosenLogo.src} />
</Layout>
