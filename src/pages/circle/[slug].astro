---
import { render } from 'astro:content';
import SiteFooter from '../../components/layout/SiteFooter.astro';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import Layout from '../../layouts/Layout.astro';
import { CIRCLE_CATEGORY_LABELS, CIRCLE_GENRE_LABELS } from '../../lib/circles';
import { getCollectionOrEmpty } from '../../lib/content';

export async function getStaticPaths() {
	const circles = await getCollectionOrEmpty('circles');
	return circles.map((circle) => ({
		params: { slug: circle.id },
		props: { circle },
	}));
}

const { circle } = Astro.props;
const { Content } = await render(circle);
const {
	name,
	category,
	genre,
	summary,
	highlights,
	details,
	location,
	rainLocation,
	scheduleDay1,
	scheduleDay2,
	image,
	otherImages,
	snsLinks,
	fesflowPlanned,
	fesflowUrl,
} = circle.data;
const schedules = [
	{ label: '10月24日（土）', value: scheduleDay1 },
	{ label: '10月25日（日）', value: scheduleDay2 },
];
---

<Layout title={`${name} | サークル | 第34回 茨香祭`}>
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<article class="surface-panel mt-8 rounded-2xl p-5 text-text sm:p-8">
			<a href="/circle" class="text-sm text-text underline hover:no-underline">← サークル一覧へ</a>

			<div class="mt-4 overflow-hidden rounded-xl">
				{
					image ? (
						<img src={image} alt="" class="aspect-square w-full object-cover" />
					) : (
						<div
							class="kikko flex aspect-square w-full items-center justify-center bg-text/5 text-sm text-text/60"
							aria-hidden="true"
						>
							画像準備中
						</div>
					)
				}
			</div>

			<div class="mt-4 flex flex-wrap gap-2">
				<span class="rounded border border-text px-2 py-0.5 text-xs text-text">
					{CIRCLE_CATEGORY_LABELS[category]}
				</span>
				<span class="rounded border border-text px-2 py-0.5 text-xs text-text">
					{CIRCLE_GENRE_LABELS[genre]}
				</span>
			</div>
			<h1 class="mt-2 text-2xl font-bold text-text">{name}</h1>
			<p class="mt-2 text-sm text-text">{summary}</p>

			<dl class="mt-4 grid grid-cols-[8rem_1fr] gap-y-2 text-sm text-text">
				{
					schedules.map((day) => (
						<>
							<dt class="font-medium">{day.label}</dt>
							<dd>{day.value || '実施なし'}</dd>
						</>
					))
				}
				<dt class="font-medium">場所</dt>
				<dd>{location}</dd>
				{rainLocation && (
					<>
						<dt class="font-medium">雨天時</dt>
						<dd>{rainLocation}</dd>
					</>
				)}
			</dl>

			{
				highlights && (
					<section class="mt-6">
						<h2 class="text-base font-bold text-text">見所</h2>
						<p class="mt-1 whitespace-pre-line text-sm text-text">{highlights}</p>
					</section>
				)
			}

			{
				details && (
					<section class="mt-6">
						<h2 class="text-base font-bold text-text">値段設定・企画詳細</h2>
						<p class="mt-1 whitespace-pre-line text-sm text-text">{details}</p>
					</section>
				)
			}

			<div class="circle-body mt-4 flex flex-col gap-3 text-text">
				<Content />
			</div>

			{
				otherImages.length > 0 && (
					<ul class="mt-6 grid grid-cols-2 gap-3">
						{otherImages.map((src) => (
							<li>
								<img src={src} alt="" loading="lazy" class="aspect-square w-full rounded-xl object-cover" />
							</li>
						))}
					</ul>
				)
			}

			{
				snsLinks.length > 0 && (
					<ul class="mt-4 flex flex-wrap gap-4 text-sm">
						{snsLinks.map((link) => (
							<li>
								<a
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									class="text-text underline hover:no-underline"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				)
			}

			<div class="mt-6 border-t border-text pt-4">
				{
					fesflowPlanned && fesflowUrl ? (
						<a
							href={fesflowUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-block rounded-lg bg-accent px-4 py-2 text-sm font-bold text-base"
						>
							FesFlow で見る
						</a>
					) : fesflowPlanned ? (
						<p class="text-sm text-text">FesFlow ページは準備中です。</p>
					) : (
						<p class="text-sm text-text">当日は会場でのご案内となります。</p>
					)
				}
			</div>
		</article>
	</main>

	<SiteFooter />
</Layout>

<style>
	.circle-body :global(a) {
		text-decoration: underline;
	}
	.circle-body :global(strong) {
		font-weight: 700;
	}
	.circle-body :global(ul) {
		list-style: disc;
		padding-left: 1.25rem;
	}
	.circle-body :global(ol) {
		list-style: decimal;
		padding-left: 1.25rem;
	}
</style>
