---
import '@fontsource/kiwi-maru/400.css';
import '@fontsource/kiwi-maru/500.css';
import '../styles/global.css';
import LoadingScreen from '../components/layout/LoadingScreen.astro';
import EdgeKasumi from '../components/layout/EdgeKasumi';

interface Props {
	title?: string;
	description?: string;
	/**
	 * body の地色を差し替えるクラス。
	 * 既定はポスターに合わせた濃紺＋亀甲で、全ページがこれを使う。
	 */
	bodyClass?: string;
	/**
	 * 画面の左右端に霞の雲（EdgeKasumi）を出すか。
	 * 既定で全ページに出す。全画面の演出を持つページ（404 など）では切る。
	 */
	edgeKasumi?: boolean;
}

const {
	title = '茨香祭 | 第34回 茨城工業高等専門学校 文化祭',
	description = '第34回 茨城工業高等専門学校 文化祭（茨香祭）の公式Webサイトです。テーマ「守破離」のもと、和風×サイバーパンクの新しい文化祭をお届けします。',
	bodyClass = 'kikko bg-base text-text',
	edgeKasumi = true
} = Astro.props;

// astro.config.mjs の site を基準に絶対 URL を組み立てる。
// site 未設定の環境（古い設定で起動した dev サーバーなど）でも落ちないようリクエスト元にフォールバックする。
const siteOrigin = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, siteOrigin);
const ogImageURL = new URL('/ogp.png', siteOrigin);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- SEO & OGP -->
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta property="og:site_name" content="第34回 茨香祭" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class:list={[bodyClass ?? 'bg-text text-base']}>
		{/*
		 * 読み込み中の覆い。View Transitions を使っていない素の MPA なので、
		 * これを Layout に置くだけでページ遷移のたびに出る。
		 */}
		<LoadingScreen />
		{/* 画面の左右端に固定する霞。スクロールしても残る。 */}
		{edgeKasumi && <EdgeKasumi />}
		<slot />
	</body>
</html>
