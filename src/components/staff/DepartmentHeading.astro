---
/*
 * 部署紹介カードの見出しバナー（/staff）。
 *
 * 部署ごとに完成したバナー画像（bannerImage、16:9）があれば、それをそのまま表示する。
 * 画像の中の文字は読み上げられないので、部署名と英語名は見えない見出しとして添える。
 *
 * 画像がない部署は、同じ背景（光線・照明機材・六角形・霞・ロゴ。画像は共通の 1 枚）の上に、
 * 部署名・二重線・英語名を重ねて、完成画像と同じ見た目にする。
 * 書体は完成画像に近いもの（日本語: Yusei Magic、英語: Oxanium）。
 * 位置と大きさは完成画像（機材部）を測った値で、バナー自身の幅を基準（cqw）にしているので、
 * カードが 1 列でも 2 列でも同じ見た目で拡縮する。
 */
import '@fontsource/oxanium/500.css';
import '@fontsource/yusei-magic/400.css';

interface Props {
	department: string;
	englishName?: string;
	bannerImage?: string;
}

const { department, englishName, bannerImage } = Astro.props;

/*
 * 部署名の大きさ。完成画像（3 文字）の大きさを上限に、名前が長い部署
 * （当日運営部門など）でも幅 56% に収まるように縮める。二重線は部署名より少し広く引く。
 * 完成画像の書体は縦長なので、Yusei Magic は大きめに出して横に 0.75 倍へ詰める（TITLE_SQUEEZE）。
 */
const TITLE_SQUEEZE = 0.75;
const titleChars = Array.from(department).length;
const titleSize = Math.min(14, 56 / (titleChars * TITLE_SQUEEZE));
const ruleWidth = Math.max(47.5, titleChars * titleSize * TITLE_SQUEEZE + 14);

/* 英語名も同じく、長いもの（Day-of Operations Division など）は縮めて幅に収める。 */
const enSize = englishName ? Math.min(3.3, 60 / (Array.from(englishName).length * 0.6)) : 3.3;
---

<div class="dept-banner" style={`--title-size: ${titleSize.toFixed(2)}cqw; --squeeze: ${TITLE_SQUEEZE}; --rule-width: ${ruleWidth.toFixed(2)}cqw; --en-size: ${enSize.toFixed(2)}cqw;`}>
	{bannerImage ? (
		<>
			<img src={bannerImage} alt="" width="1280" height="720" loading="lazy" decoding="async" class="dept-bg" />
			<h3 class="sr-only">{englishName ? `${department}（${englishName}）` : department}</h3>
		</>
	) : (
		<>
			<img src="/images/staff/department-banner-bg.webp" alt="" width="1920" height="1080" loading="lazy" decoding="async" class="dept-bg" />
			<h3 class="dept-title">{department}</h3>
			<div class="dept-rule" aria-hidden="true"></div>
			{englishName && <p class="dept-en" lang="en">{englishName}</p>}
		</>
	)}
</div>

<style>
	.dept-banner {
		position: relative;
		overflow: hidden;
		container-type: inline-size;
		aspect-ratio: 16 / 9;
		background-color: var(--color-base);
		color: #fff;
	}

	.dept-banner > * {
		position: absolute;
	}

	.dept-bg {
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	/* 位置は完成画像（1280×720）での中心を割合にしたもの。 */
	.dept-title,
	.dept-en {
		left: 50%;
		margin: 0;
		white-space: nowrap;
		transform: translate(-50%, -50%);
	}

	.dept-title {
		transform: translate(-50%, -50%) scaleX(var(--squeeze));
		top: 47.4%;
		font-family: 'Yusei Magic', var(--font-primary);
		font-size: var(--title-size);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0.04em;
	}

	/* 部署名の下の二重線。細い線 2 本（太さ 0.3cqw、間隔 0.4cqw）。 */
	.dept-rule {
		top: 62.1%;
		left: 50%;
		width: var(--rule-width);
		height: 1cqw;
		transform: translate(-50%, -50%);
		border-top: 0.3cqw solid var(--color-accent);
		border-bottom: 0.3cqw solid var(--color-accent);
	}

	.dept-en {
		top: 67.4%;
		font-family: 'Oxanium', var(--font-primary);
		font-size: var(--en-size);
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.03em;
	}
</style>
