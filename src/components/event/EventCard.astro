---
import {
	EVENT_GENRE_LABELS,
	EVENT_STATUS_LABELS,
	EVENT_VENUE_LABELS,
	formatEventDate,
	formatEventTimeRange,
	type EventGenre,
	type EventStatus,
	type EventVenue,
} from '../../lib/events';
import SquareImage from '../ui/SquareImage.astro';

interface Props {
	title: string;
	performer: string;
	startAt: Date;
	endAt: Date;
	genre: EventGenre;
	status: EventStatus;
	venue: EventVenue;
	image?: string | undefined;
}

const { title, performer, startAt, endAt, genre, status, venue, image } = Astro.props;
---

<article
	class="flex min-w-0 items-stretch overflow-hidden rounded-xl border border-base bg-base text-text transition-transform hover:-translate-y-0.5"
>
	<div class="flex w-1/3 max-w-44 shrink-0 items-center justify-center pl-2">
		<SquareImage src={image} className="w-full" />
	</div>
	<div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5 p-3 sm:gap-2 sm:p-4">
		<div class="flex flex-wrap gap-2 text-xs">
			<span class="rounded border border-text px-2 py-0.5">{EVENT_GENRE_LABELS[genre]}</span>
			{
				status !== 'scheduled' && (
					<span class="rounded bg-main px-2 py-0.5 font-medium text-base">
						{EVENT_STATUS_LABELS[status]}
					</span>
				)
			}
		</div>
		<p class="text-sm text-accent">{formatEventDate(startAt)} {formatEventTimeRange(startAt, endAt)}</p>
		<h3 class:list={['text-lg font-medium', status === 'cancelled' && 'line-through']}>{title}</h3>
		<p class="text-sm text-text/80">{performer}</p>
		<p class="text-xs text-text/70">{EVENT_VENUE_LABELS[venue]}</p>
	</div>
</article>
