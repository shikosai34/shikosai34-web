---
/*
 * フッターの上に和傘を並べる帯。
 *
 * 絵はいただいたジェネレータ（Python）が出力した4種類：
 * 青海波・市松・麻の葉・渦。src/assets/wagasa/ に置いてある。
 * 濃紺の地に載せるため、面は透過・線は薄い白に変えてある
 * （生成時は白い面＋黒い線で、そのままだと白い円盤に見えるため）。
 *
 * <img> で読むのは、4枚合わせて 140KB ほどあり、
 * インラインにすると HTML がその分重くなるため。
 * Astro が最適化・キャッシュする経路に乗せる。
 *
 * 回転は参考サイト（cho-kaguyahime.com）の @keyframes umbrella に倣い、
 * 14〜17秒で傘ごとに速度と向きを変える。
 *
 * フッターは上端が弧になっているので、下げすぎると縁で切れる。
 *
 * 4本の合計幅は 390px 幅の画面より広いので、固定幅にせず
 * 画面幅に合わせて縮め（flex-1 + max-w-*）、横にはみ出さないようにする。
 *
 * 装飾なので aria-hidden。
 */
import seigaiha from '../../assets/wagasa/wagasa-seigaiha.svg';
import ichimatsu from '../../assets/wagasa/wagasa-ichimatsu.svg';
import asanoha from '../../assets/wagasa/wagasa-asanoha.svg';
import uzu from '../../assets/wagasa/wagasa-uzu.svg';

const UMBRELLAS = [
	{ src: seigaiha.src, alt: '', spin: 'wagasa-spin-15', size: 'max-w-24 sm:max-w-32', lift: '-translate-y-1' },
	{ src: ichimatsu.src, alt: '', spin: 'wagasa-spin-16 wagasa-reverse', size: 'max-w-28 sm:max-w-36', lift: '' },
	{ src: asanoha.src, alt: '', spin: 'wagasa-spin-14', size: 'max-w-28 sm:max-w-36', lift: '' },
	{ src: uzu.src, alt: '', spin: 'wagasa-spin-17 wagasa-reverse', size: 'max-w-24 sm:max-w-32', lift: '-translate-y-1' },
];
---

<div
	aria-hidden="true"
	class="pointer-events-none relative -mb-2 flex items-end justify-center gap-2 px-4 sm:gap-6"
>
	{
		UMBRELLAS.map((u) => (
			<span class={`block min-w-0 flex-1 ${u.lift} ${u.size}`}>
				<img src={u.src} alt="" loading="lazy" decoding="async" class={`h-auto w-full ${u.spin}`} />
			</span>
		))
	}
</div>
