---
/**
 * 未作成ページ用の仮ページ。
 * /circle の「サークル情報は準備中です。」と同じ体裁で「〜は準備中です。」を表示する。
 */
import SiteFooter from '../layout/SiteFooter.astro';
import SiteHeader from '../layout/SiteHeader.astro';
import SectionHeading from './SectionHeading';
import type { SectionIconName } from '../icons/SectionIcon';
import Layout from '../../layouts/Layout.astro';

interface Props {
	/** ページタイトル（日本語）。<title> に「| 第34回 茨香祭」を付けて使う。 */
	title: string;
	/** セクション見出し（英語）。SectionHeading に渡す。 */
	heading: string;
	/** 見出しの左に置くアイコン。 */
	icon: SectionIconName;
	/** 準備中メッセージ。省略時は「{title}は準備中です。」 */
	message?: string;
}

const { title, heading, icon, message = `${title}は準備中です。` } = Astro.props;
---

<Layout title={`${title} | 第34回 茨香祭`}>
	<SiteHeader />

	<main class="mx-auto w-full max-w-3xl px-4 pb-16 sm:px-6">
		<section class="surface-panel mt-8 rounded-2xl p-4 pt-6 pb-6 sm:p-6">
			<SectionHeading title={heading} icon={icon} />
			<p class="py-8 text-center text-sm text-text/70">{message}</p>
		</section>
	</main>

	<SiteFooter />
</Layout>
