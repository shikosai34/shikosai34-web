---
import { CIRCLE_CATEGORY_LABELS, type CircleCategory } from '../../lib/circles';

interface Props {
	name: string;
	category: CircleCategory;
	location: string;
	image?: string | undefined;
}

const { name, category, location, image } = Astro.props;
---

<article class="flex h-full flex-col overflow-hidden rounded-xl border border-base/15 bg-base/5 transition-transform hover:-translate-y-0.5">
	{
		image ? (
			<img src={image} alt="" loading="lazy" class="aspect-video w-full object-cover" />
		) : (
			<div
				class="flex aspect-video w-full items-center justify-center bg-base/10 text-xs text-base/40"
				aria-hidden="true"
			>
				画像準備中
			</div>
		)
	}
	<div class="flex flex-1 flex-col gap-1.5 p-3">
		<span class="self-start rounded bg-base/10 px-1.5 py-0.5 text-xs text-base/70">
			{CIRCLE_CATEGORY_LABELS[category]}
		</span>
		<h3 class="font-medium text-base">{name}</h3>
		<p class="mt-auto text-sm text-base/60">{location}</p>
	</div>
</article>
