---
import {
    CIRCLE_CATEGORY_LABELS,
    CIRCLE_GENRE_LABELS,
    type CircleCategory,
    type CircleGenre,
} from "../../lib/circles";

interface Props {
    name: string;
    category: CircleCategory;
    genre: CircleGenre;
    summary: string;
    location: string;
    image?: string | undefined;
}

const { name, category, genre, summary, location, image } = Astro.props;
---

<article
    class="flex min-w-0 items-stretch overflow-hidden rounded-xl border border-base bg-base text-text transition-transform hover:-translate-y-0.5"
>
    {
        image ? (
            <div class="aspect-square w-[30%] min-w-24 max-w-72 shrink-0 self-start overflow-hidden">
                <img src={image} alt="" loading="lazy" class="h-full w-full object-cover" />
            </div>
        ) : (
            <div
                class="kikko flex aspect-square w-[30%] min-w-24 max-w-72 shrink-0 self-start items-center justify-center bg-text/5 text-center text-xs text-text/60"
                aria-hidden="true"
            >
                画像準備中
            </div>
        )
    }
    <div class="flex min-w-0 flex-1 flex-col justify-center gap-1.5 p-3 sm:gap-2 sm:p-4">
        <div class="flex flex-wrap gap-1">
            <span
                class="rounded border border-text px-1.5 py-0.5 text-xs text-text"
            >
                {CIRCLE_CATEGORY_LABELS[category]}
            </span>
            <span
                class="rounded border border-text px-1.5 py-0.5 text-xs text-text"
            >
                {CIRCLE_GENRE_LABELS[genre]}
            </span>
        </div>
        <h3 class="font-medium text-text">{name}</h3>
        <p class="line-clamp-2 text-sm text-text/80">{summary}</p>
        <p class="text-sm text-text">{location}</p>
    </div>
</article>
