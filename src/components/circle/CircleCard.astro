---
import CalendarIcon from '../icons/CalendarIcon';
import GlobeIcon from '../icons/GlobeIcon';
import InstagramIcon from '../icons/InstagramIcon';
import MapPinIcon from '../icons/MapPinIcon';
import XLogoIcon from '../icons/XLogoIcon';

interface SnsLink {
	label: string;
	url: string;
}

interface Props {
	name: string;
	location: string;
	schedule: string;
	description: string;
	image?: string | undefined;
	snsLinks?: SnsLink[];
}

const { name, location, schedule, description, image, snsLinks = [] } = Astro.props;

function snsIcon(label: string) {
	const key = label.toLowerCase();
	if (key.includes('insta')) return InstagramIcon;
	if (key === 'x' || key.includes('twitter')) return XLogoIcon;
	return GlobeIcon;
}
---

<article class="flex gap-3 rounded-xl border border-base p-3">
	{
		image ? (
			<img
				src={image}
				alt=""
				loading="lazy"
				class="h-20 w-20 shrink-0 rounded-lg object-cover"
			/>
		) : (
			<div
				class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-base text-[0.625rem] text-text"
				aria-hidden="true"
			>
				画像準備中
			</div>
		)
	}

	<div class="flex min-w-0 flex-1 flex-col gap-1">
		<h3 class="font-bold text-base">{name}</h3>

		<p class="flex items-center gap-1.5 text-sm text-base">
			<CalendarIcon className="h-3.5 w-3.5 shrink-0" />
			<span class="truncate">{schedule}</span>
		</p>
		<p class="flex items-center gap-1.5 text-sm text-base">
			<MapPinIcon className="h-3.5 w-3.5 shrink-0" />
			<span class="truncate">{location}</span>
		</p>

		<p class="line-clamp-2 text-sm text-base">{description}</p>

		{
			snsLinks.length > 0 && (
				<div class="mt-1 flex justify-end gap-3">
					{snsLinks.map((link) => {
						const Icon = snsIcon(link.label);
						return (
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="text-base"
								aria-label={link.label}
							>
								<Icon className="h-4 w-4" />
							</a>
						);
					})}
				</div>
			)
		}
	</div>
</article>
